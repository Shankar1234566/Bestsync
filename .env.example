# BeatSync environment variables
# Copy to `.env` (git-ignored) and adjust. Every value below is a placeholder.

# API port. In dev, vite.config.ts proxies /api and /ws to this port.
PORT=4000

# REQUIRED in production (NODE_ENV=production): the server refuses to boot without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Development/test fall back to a clearly labelled built-in secret — never do that in production.
JWT_SECRET=

# Token lifetime (jsonwebtoken format).
JWT_EXPIRES_IN=7d

# SQLite database file. Directory is created automatically. WAL mode is enabled.
DB_PATH=beatsync-data/beatsync.db

# Comma-separated allowed browser origins for cross-origin requests.
# Default: http://localhost:5173,http://localhost:4000 (the dev servers).
CORS_ORIGIN=

# Set to 1 when running behind a reverse proxy (nginx, Caddy, ...) so the
# rate limiter sees the client's real IP instead of the proxy's.
# TRUST_PROXY=1

# Where the production server looks for the built client (relative to the repo root).
#CLIENT_DIST=dist

# Node environment: development | test | production
NODE_ENV=development
